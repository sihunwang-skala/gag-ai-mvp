# 비워두면 Mock Mode로 실행됩니다 (API Key 불필요).
# mock | anthropic | openai_compatible
HUMOR_LLM_PROVIDER=mock

# provider=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# provider=openai_compatible (OpenAI 또는 호환 서버)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# SQLite 기본. PostgreSQL 예: postgresql+psycopg://user:pass@localhost/gagai (psycopg 별도 설치)
DATABASE_URL=sqlite:///./data/humor.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
